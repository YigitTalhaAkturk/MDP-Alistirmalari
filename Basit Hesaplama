#include <stdio.h>

int main() {
   
   int sayi_1;
   int sayi_2;
   int toplam=0;
   int fark=0;
   int carpim=0;
   float bolum=0;
 
    printf("selam! bu sistemde sececeginiz 2 sayi ile temel islemler yapilir.\n\n");
    printf("islem yapacaginiz birinci sayiyi giriniz:");
    scanf("%d",&sayi_1);
    printf("islem yapacaginiz ikinci sayiyi giriniz:");
    scanf("%d",&sayi_2);
   
   toplam=sayi_1+sayi_2;
   fark=sayi_1-sayi_2;
   carpim=sayi_1*sayi_2;
   bolum=(float)sayi_1/sayi_2;
   
    printf("\nsayilarin toplami=%d\n",toplam);
    printf("sayilarin farki=%d\n",fark);
    printf("sayilarin carpimi=%d\n",carpim);
    printf("sayilarin bolumu=%.2f\n",bolum);
    return 0;
}
